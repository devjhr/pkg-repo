#!/data/data/com.jahangir/files/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════════╗
# ║   AndroStudio CLI Tool v2.6                                  ║
# ║   Usage: androstudio <command> [args]                        ║
# ╚══════════════════════════════════════════════════════════════╝

HOME_DIR="$HOME"
SDK_DIR="$HOME/android-sdk"
NDK_DIR="$SDK_DIR/ndk"
CMAKE_DIR="$SDK_DIR/cmake"
CMDTOOLS_URL="https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip"
CMDTOOLS_DIR="$SDK_DIR/cmdline-tools/latest"
SDKMANAGER="$CMDTOOLS_DIR/bin/sdkmanager"
RELEASE_BASE="https://github.com/devjhr/pkg-repo/releases/download/v1.0"

# ── Preset packages (name|filename|url) ───────────────────────
RELEASE_PACKAGES=(
    "openjdk-21|openjdk-21_21.0.10_aarch64.deb|$RELEASE_BASE/openjdk-21_21.0.10_aarch64.deb"
    "openjdk-17|openjdk-17_17.0.18_aarch64.deb|$RELEASE_BASE/openjdk-17_17.0.18_aarch64.deb"
    "gradle|gradle_9.3.1_all.deb|$RELEASE_BASE/gradle_9.3.1_all.deb"
)

NDK_VERSIONS=(
    "r29|29.0.14206865|https://github.com/devjhr/pkg-repo/releases/download/v1.0/android-ndk-r29-aarch64-linux-musl.tar.xz"
)

CMAKE_VERSIONS=("3.10.2" "3.18.1" "3.22.1" "3.25.1")
CMAKE_BASE_URL="https://github.com/MrIkso/AndroidIDE-NDK/releases/download/cmake"

GREEN='\033[0;32m'
AMBER='\033[0;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MUTED='\033[0;90m'
BOLD='\033[1m'
RESET='\033[0m'

info()    { echo -e "  ${BLUE}→${RESET} $*"; }
success() { echo -e "  ${GREEN}✓${RESET} $*"; }
warn()    { echo -e "  ${AMBER}!${RESET} $*"; }
error()   { echo -e "  ${RED}✗${RESET} $*"; }
step()    { echo -e "\n  ${BOLD}${CYAN}[$1]${RESET} $2"; }
divider() { echo "  ────────────────────────────────────────────────────"; }

detect_shell_rc() {
    [ -f "$HOME_DIR/.zshrc" ] && echo "$HOME_DIR/.zshrc" || echo "$HOME_DIR/.bashrc"
}

write_env() {
    local shell_rc="$1"
    sed -i '/# ── AndroStudio Environment/,/# ── End AndroStudio/d' "$shell_rc" 2>/dev/null
    cat >> "$shell_rc" << 'ENV'

# ── AndroStudio Environment ────────────────────────────────
export ANDROID_HOME="$HOME/android-sdk"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$PATH"

export JAVA_HOME="$(dirname $(dirname $(readlink -f $(which java))))"
export PATH="$JAVA_HOME/bin:$PATH"

for ver in $(ls -r $ANDROID_HOME/build-tools/ 2>/dev/null); do
    export PATH="$ANDROID_HOME/build-tools/$ver:$PATH"
done
# ── End AndroStudio ─────────────────────────────────────────
ENV
}

check_curl()  { command -v curl  &>/dev/null || { error "curl not found — pkg install curl";  exit 1; }; }
check_unzip() { command -v unzip &>/dev/null || { error "unzip not found — pkg install unzip"; exit 1; }; }
check_java()  { command -v java  &>/dev/null || { error "Java not found — androstudio install pkg openjdk-21"; exit 1; }; }

# ═════════════════════════════════════════════════════════════
# COMMAND: install pkg
# ═════════════════════════════════════════════════════════════
cmd_install_pkg() {
    local target="${1:-}"

    # ── List mode ─────────────────────────────────────────────
    if [ "$target" = "--list" ] || [ -z "$target" ]; then
        echo ""
        echo -e "  ${BOLD}AndroStudio — Available Packages${RESET}"
        divider
        echo -e "  ${MUTED}Hosted at: github.com/devjhr/pkg-repo/releases/v1.0${RESET}"
        echo ""
        for entry in "${RELEASE_PACKAGES[@]}"; do
            local name file
            name=$(echo "$entry" | cut -d'|' -f1)
            file=$(echo "$entry" | cut -d'|' -f2)
            local installed=""
            dpkg -l "$name" &>/dev/null 2>&1 && installed="${GREEN} ✓ installed${RESET}"
            echo -e "  ${CYAN}•${RESET} $(printf '%-16s' "$name") ${MUTED}$file${RESET}$installed"
        done
        echo ""
        echo -e "  Usage: ${CYAN}androstudio install pkg <name>${RESET}"
        echo -e "  Usage: ${CYAN}androstudio install pkg all${RESET}"
        echo ""
        return
    fi

    check_curl

    # ── Install all ───────────────────────────────────────────
    if [ "$target" = "all" ]; then
        echo ""
        echo -e "  ${BOLD}AndroStudio — Installing all packages${RESET}"
        divider
        for entry in "${RELEASE_PACKAGES[@]}"; do
            _do_install_pkg "$entry"
        done
        return
    fi

    # ── Install specific package ──────────────────────────────
    local found=""
    for entry in "${RELEASE_PACKAGES[@]}"; do
        local name
        name=$(echo "$entry" | cut -d'|' -f1)
        if [ "$name" = "$target" ]; then
            found="$entry"
            break
        fi
    done

    if [ -z "$found" ]; then
        error "Unknown package: $target"
        echo -e "  ${MUTED}Run: androstudio install pkg --list${RESET}"
        exit 1
    fi

    echo ""
    echo -e "  ${BOLD}AndroStudio — Install Package${RESET}"
    divider
    _do_install_pkg "$found"
}

_do_install_pkg() {
    local entry="$1"
    local name file url
    name=$(echo "$entry" | cut -d'|' -f1)
    file=$(echo "$entry" | cut -d'|' -f2)
    url=$(echo "$entry"  | cut -d'|' -f3)

    if dpkg -l "$name" &>/dev/null 2>&1; then
        success "$name already installed"
        return
    fi

    info "Installing $name..."
    info "Downloading $file..."
    curl -L --progress-bar "$url" -o "$TMPDIR/$file"

    if [ ! -s "$TMPDIR/$file" ]; then
        error "Download failed: $name"
        rm -f "$TMPDIR/$file"
        return
    fi

    info "Installing $file..."
    apt install -y "$TMPDIR/$file" && success "$name installed!" || error "$name install failed"
    rm -f "$TMPDIR/$file"
}

# ═════════════════════════════════════════════════════════════
# COMMAND: setup
# ═════════════════════════════════════════════════════════════
cmd_setup() {
    echo ""
    echo -e "  ${BOLD}AndroStudio — Full Environment Setup${RESET}"
    divider

    check_curl; check_unzip

    local shell_rc
    shell_rc=$(detect_shell_rc)

    # ── Pre-step 1: openjdk-21 ────────────────────────────────
    step "1/8" "Installing openjdk-21..."
    local jdk_entry=""
    for entry in "${RELEASE_PACKAGES[@]}"; do
        [[ "$entry" == openjdk-21* ]] && jdk_entry="$entry" && break
    done
    if [ -n "$jdk_entry" ]; then
        _do_install_pkg "$jdk_entry"
    else
        warn "openjdk-21 not found in package list"
    fi

    check_java

    # ── Pre-step 2: gradle ────────────────────────────────────
    step "2/8" "Installing gradle..."
    local gradle_entry=""
    for entry in "${RELEASE_PACKAGES[@]}"; do
        [[ "$entry" == gradle* ]] && gradle_entry="$entry" && break
    done
    if [ -n "$gradle_entry" ]; then
        _do_install_pkg "$gradle_entry"
    else
        warn "gradle not found in package list"
    fi

    # ── Step 3: SDK directory ─────────────────────────────────
    step "3/8" "Creating SDK directory structure..."
    mkdir -p "$SDK_DIR"/{cmdline-tools,platform-tools,platforms,build-tools,ndk,cmake,licenses}
    success "SDK root: $SDK_DIR"

    # ── Step 4: cmdline-tools ─────────────────────────────────
    step "4/8" "Downloading Android cmdline-tools..."
    if [ -f "$SDKMANAGER" ]; then
        success "cmdline-tools already installed"
    else
        local tmp_zip="$TMPDIR/cmdtools.zip" tmp_dir="$TMPDIR/cmdtools-extract"
        curl -L --progress-bar "$CMDTOOLS_URL" -o "$tmp_zip"
        [ ! -f "$tmp_zip" ] && error "Download failed!" && exit 1
        rm -rf "$tmp_dir"
        unzip -q "$tmp_zip" -d "$tmp_dir"
        mkdir -p "$CMDTOOLS_DIR"
        if [ -d "$tmp_dir/cmdline-tools" ]; then
            cp -r "$tmp_dir/cmdline-tools/." "$CMDTOOLS_DIR/"
        else
            cp -r "$tmp_dir/." "$CMDTOOLS_DIR/"
        fi
        rm -rf "$tmp_zip" "$tmp_dir"
        success "cmdline-tools installed"
    fi
    chmod -R 755 "$CMDTOOLS_DIR/bin/" 2>/dev/null

    # ── Step 5: Accept licenses ───────────────────────────────
    step "5/8" "Accepting Android SDK licenses..."
    export ANDROID_HOME="$SDK_DIR"
    export ANDROID_SDK_ROOT="$SDK_DIR"
    export JAVA_HOME="$(dirname $(dirname $(readlink -f $(which java))))"
    export PATH="$JAVA_HOME/bin:$CMDTOOLS_DIR/bin:$SDK_DIR/platform-tools:$PATH"
    yes | "$SDKMANAGER" --licenses > /dev/null 2>&1 \
        && success "All licenses accepted" \
        || warn "Some licenses may not have been accepted"

    # ── Step 6: platform-tools ────────────────────────────────
    step "6/8" "Installing platform-tools..."
    "$SDKMANAGER" "platform-tools" && success "platform-tools installed" || warn "Failed"

    # ── Step 7: platform + build-tools ───────────────────────
    step "7/8" "Installing latest platform and build-tools..."
    local latest_platform latest_buildtools
    latest_platform=$("$SDKMANAGER" --list 2>/dev/null | grep "platforms;android-" | grep -v "preview\|beta\|rc" | awk '{print $1}' | sort -t- -k2 -Vr | head -1)
    latest_buildtools=$("$SDKMANAGER" --list 2>/dev/null | grep "build-tools;" | grep -v "preview\|beta\|rc" | awk '{print $1}' | sort -t\; -k2 -Vr | head -1)
    [ -z "$latest_platform" ]   && latest_platform="platforms;android-35"
    [ -z "$latest_buildtools" ] && latest_buildtools="build-tools;35.0.0"
    info "Platform   : $latest_platform"
    info "Build-tools: $latest_buildtools"
    "$SDKMANAGER" "$latest_platform" "$latest_buildtools" \
        && success "Platform + build-tools installed" || warn "Partially failed"

    # ── Step 8: Write env ─────────────────────────────────────
    step "8/8" "Writing environment variables..."
    write_env "$shell_rc"
    success "Written to $shell_rc"

    echo ""
    divider
    echo -e "  ${GREEN}${BOLD}Setup complete!${RESET}"
    divider
    printf "  %-20s %s\n" "ANDROID_HOME:" "$SDK_DIR"
    printf "  %-20s %s\n" "JAVA_HOME:"    "$(dirname $(dirname $(readlink -f $(which java))))"
    printf "  %-20s %s\n" "Platform:"     "$latest_platform"
    printf "  %-20s %s\n" "Build-tools:"  "$latest_buildtools"
    echo ""
    echo -e "  Apply now: ${CYAN}source $shell_rc${RESET}"
    echo ""
}

# ═════════════════════════════════════════════════════════════
# COMMAND: install ndk
# ═════════════════════════════════════════════════════════════
cmd_install_ndk() {
    echo ""
    echo -e "  ${BOLD}AndroStudio — Install NDK + cmake${RESET}"
    divider
    echo -e "  ${MUTED}Source: github.com/devjhr/pkg-repo/releases${RESET}"
    echo ""

    check_curl; check_unzip

    echo -e "  ${BOLD}Available NDK versions:${RESET}"
    echo ""
    local i=1
    for entry in "${NDK_VERSIONS[@]}"; do
        local name ver
        name=$(echo "$entry" | cut -d'|' -f1)
        ver=$(echo "$entry"  | cut -d'|' -f2)
        local installed=""
        [ -d "$NDK_DIR/$ver" ] && installed="${GREEN} ✓ installed${RESET}"
        echo -e "  ${CYAN}[$i]${RESET} NDK $name  ${MUTED}($ver)${RESET}$installed"
        i=$((i + 1))
    done
    echo -e "  ${CYAN}[q]${RESET} Cancel"
    echo ""
    printf "  Select [1-${#NDK_VERSIONS[@]}]: "
    read -r choice

    [ "$choice" = "q" ] && echo "" && info "Cancelled." && echo "" && return

    if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#NDK_VERSIONS[@]}" ]; then
        error "Invalid selection"; exit 1
    fi

    local selected="${NDK_VERSIONS[$((choice - 1))]}"
    local ndk_name ndk_ver ndk_url
    ndk_name=$(echo "$selected" | cut -d'|' -f1)
    ndk_ver=$(echo "$selected"  | cut -d'|' -f2)
    ndk_url=$(echo "$selected"  | cut -d'|' -f3)

    local ndk_install_dir="$NDK_DIR/$ndk_ver"
    local ndk_file
    ndk_file=$(basename "$ndk_url")

    echo ""
    info "Selected: NDK $ndk_name ($ndk_ver)"

    if [ -d "$ndk_install_dir" ]; then
        success "NDK $ndk_name already installed at $ndk_install_dir"
        echo ""
    else
        local home_ndk=""
        [ -d "$HOME_DIR/$ndk_ver" ]              && home_ndk="$HOME_DIR/$ndk_ver"
        [ -d "$HOME_DIR/android-ndk-$ndk_name" ] && home_ndk="$HOME_DIR/android-ndk-$ndk_name"

        if [ -n "$home_ndk" ]; then
            info "Found NDK at $home_ndk — moving to SDK..."
            mkdir -p "$NDK_DIR"
            mv "$home_ndk" "$ndk_install_dir"
            success "Moved to $ndk_install_dir"
        else
            info "Downloading NDK $ndk_name..."
            info "URL: $ndk_url"
            curl -L --progress-bar "$ndk_url" -o "$TMPDIR/$ndk_file"
            if [ ! -s "$TMPDIR/$ndk_file" ]; then
                error "Download failed!"; rm -f "$TMPDIR/$ndk_file"; exit 1
            fi
            info "Extracting NDK $ndk_name..."
            cd "$HOME_DIR"
            tar --no-same-owner -xf "$TMPDIR/$ndk_file" --warning=no-unknown-keyword
            rm -f "$TMPDIR/$ndk_file"
            mkdir -p "$NDK_DIR"
            local extracted_dir
            extracted_dir=$(find "$HOME_DIR" -maxdepth 1 -type d \( -name "android-ndk-*" -o -name "$ndk_ver" \) | head -1)
            if [ -n "$extracted_dir" ]; then
                mv "$extracted_dir" "$ndk_install_dir"
            else
                error "Could not find extracted NDK folder in $HOME_DIR"
                exit 1
            fi
        fi
    fi

    if [ -d "$ndk_install_dir" ]; then
        info "Creating missing symlinks for musl..."
        for path in "toolchains/llvm/prebuilt" "prebuilt" "shader-tools"; do
            if [ -d "$ndk_install_dir/$path" ]; then
                cd "$ndk_install_dir/$path"
                [ ! -e "linux-aarch64" ] && ln -s linux-arm64 linux-aarch64 2>/dev/null
            fi
        done
        success "NDK $ndk_name ready at $ndk_install_dir"
    fi

    echo ""
    echo -e "  ${BOLD}Installing cmake versions...${RESET}"
    echo -e "  ${MUTED}Source: github.com/MrIkso/AndroidIDE-NDK${RESET}"

    for old_ver in "3.10.1" "3.18.1" "3.22.1" "3.23.1"; do
        [ -d "$CMAKE_DIR/$old_ver" ] && rm -rf "$CMAKE_DIR/$old_ver" && info "Removed old cmake $old_ver"
    done

    mkdir -p "$CMAKE_DIR"
    for cmake_ver in "${CMAKE_VERSIONS[@]}"; do
        if [ -d "$CMAKE_DIR/$cmake_ver" ]; then
            success "cmake $cmake_ver already installed"; continue
        fi
        local cmake_file="cmake-${cmake_ver}-android-aarch64.zip"
        info "Downloading cmake $cmake_ver..."
        curl -L --progress-bar "$CMAKE_BASE_URL/$cmake_file" -o "$TMPDIR/$cmake_file"
        if [ ! -s "$TMPDIR/$cmake_file" ]; then
            warn "cmake $cmake_ver download failed — skipping"; continue
        fi
        unzip -qq "$TMPDIR/$cmake_file" -d "$CMAKE_DIR"
        rm -f "$TMPDIR/$cmake_file"
        chmod -R +x "$CMAKE_DIR/$cmake_ver/bin" 2>/dev/null
        success "cmake $cmake_ver installed"
    done

    local shell_rc; shell_rc=$(detect_shell_rc)
    write_env "$shell_rc"

    echo ""
    divider
    success "NDK + cmake installation complete!"
    echo -e "  Apply now: ${CYAN}source $shell_rc${RESET}"
    echo ""
}

# ═════════════════════════════════════════════════════════════
# COMMAND: status
# ═════════════════════════════════════════════════════════════
cmd_status() {
    echo ""
    echo -e "  ${BOLD}AndroStudio — Status${RESET}"
    divider

    show_tool() {
        local name="$1" cmd="$2" fix="$3"
        if command -v "$cmd" &>/dev/null; then
            local ver; ver=$("$cmd" --version 2>/dev/null | head -1 || echo "")
            echo -e "  ${GREEN}✓${RESET} $(printf '%-16s' "$name") ${MUTED}$ver${RESET}"
        else
            echo -e "  ${RED}✗${RESET} $(printf '%-16s' "$name") ${MUTED}not installed — $fix${RESET}"
        fi
    }

    echo -e "\n  ${BOLD}Core Tools${RESET}"
    show_tool "java"   "java"   "androstudio install pkg openjdk-21"
    show_tool "gradle" "gradle" "androstudio install pkg gradle"
    show_tool "aapt2"  "aapt2"  "pkg install aapt2"
    show_tool "git"    "git"    "pkg install git"

    echo -e "\n  ${BOLD}Environment${RESET}"
    local java_home; java_home="$(dirname $(dirname $(readlink -f $(which java))) 2>/dev/null)"
    [ -n "$java_home" ] \
        && echo -e "  ${GREEN}✓${RESET} JAVA_HOME       $java_home" \
        || echo -e "  ${RED}✗${RESET} JAVA_HOME       not detected"
    [ -d "$SDK_DIR" ] \
        && echo -e "  ${GREEN}✓${RESET} ANDROID_HOME    $SDK_DIR" \
        || echo -e "  ${RED}✗${RESET} ANDROID_HOME    not found — androstudio setup"

    echo -e "\n  ${BOLD}Android SDK${RESET}"
    [ -f "$SDKMANAGER" ] \
        && echo -e "  ${GREEN}✓${RESET} cmdline-tools" \
        || echo -e "  ${RED}✗${RESET} cmdline-tools   not installed — androstudio setup"
    [ -f "$SDK_DIR/platform-tools/adb" ] \
        && echo -e "  ${GREEN}✓${RESET} platform-tools" \
        || echo -e "  ${RED}✗${RESET} platform-tools  not installed — androstudio setup"
    if ls "$SDK_DIR/platforms"/android-* &>/dev/null 2>&1; then
        for p in "$SDK_DIR/platforms"/android-*/; do
            echo -e "  ${GREEN}✓${RESET} platform        $(basename "$p")"
        done
    else
        echo -e "  ${RED}✗${RESET} platform        none — androstudio setup"
    fi
    if ls "$SDK_DIR/build-tools"/[0-9]* &>/dev/null 2>&1; then
        for b in "$SDK_DIR/build-tools"/*/; do
            echo -e "  ${GREEN}✓${RESET} build-tools     $(basename "$b")"
        done
    else
        echo -e "  ${RED}✗${RESET} build-tools     none — androstudio setup"
    fi
    local lcount=0
    [ -d "$SDK_DIR/licenses" ] && lcount=$(ls "$SDK_DIR/licenses" 2>/dev/null | wc -l)
    [ "$lcount" -gt 0 ] \
        && echo -e "  ${GREEN}✓${RESET} licenses        $lcount accepted" \
        || echo -e "  ${RED}✗${RESET} licenses        not accepted — androstudio setup"

    echo -e "\n  ${BOLD}Release Packages${RESET}"
    for entry in "${RELEASE_PACKAGES[@]}"; do
        local name
        name=$(echo "$entry" | cut -d'|' -f1)
        if dpkg -l "$name" &>/dev/null 2>&1; then
            local ver; ver=$(dpkg -l "$name" 2>/dev/null | awk '/^ii/{print $3}')
            echo -e "  ${GREEN}✓${RESET} $(printf '%-16s' "$name") ${MUTED}$ver${RESET}"
        else
            echo -e "  ${RED}✗${RESET} $(printf '%-16s' "$name") ${MUTED}not installed — androstudio install pkg $name${RESET}"
        fi
    done

    echo -e "\n  ${BOLD}NDK${RESET}"
    local ndk_found=0
    if [ -d "$NDK_DIR" ]; then
        for d in "$NDK_DIR"/*/; do
            [ -d "$d" ] && echo -e "  ${GREEN}✓${RESET} NDK             $(basename "$d")" && ndk_found=1
        done
    fi
    [ "$ndk_found" -eq 0 ] && echo -e "  ${AMBER}–${RESET} NDK             not installed — androstudio install ndk"

    echo -e "\n  ${BOLD}cmake${RESET}"
    local cmake_found=0
    if [ -d "$CMAKE_DIR" ]; then
        for d in "$CMAKE_DIR"/*/; do
            [ -d "$d" ] && echo -e "  ${GREEN}✓${RESET} cmake           $(basename "$d")" && cmake_found=1
        done
    fi
    [ "$cmake_found" -eq 0 ] && echo -e "  ${AMBER}–${RESET} cmake           not installed — androstudio install ndk"
    echo ""
}

# ═════════════════════════════════════════════════════════════
# COMMAND: doctor
# ═════════════════════════════════════════════════════════════
cmd_doctor() {
    echo ""
    echo -e "  ${BOLD}AndroStudio — Doctor${RESET}"
    divider

    local issues=0

    chk() {
        local label="$1" ok="$2" fix="$3"
        if [ "$ok" = "true" ]; then
            echo -e "  ${GREEN}✓${RESET} $label"
        else
            echo -e "  ${RED}✗${RESET} $label"
            [ -n "$fix" ] && echo -e "    ${MUTED}→ Fix: $fix${RESET}"
            issues=$((issues + 1))
        fi
    }
    opt_chk() {
        local label="$1" ok="$2" fix="$3"
        if [ "$ok" = "true" ]; then
            echo -e "  ${GREEN}✓${RESET} $label"
        else
            echo -e "  ${AMBER}–${RESET} $label ${MUTED}(optional)${RESET}"
            [ -n "$fix" ] && echo -e "    ${MUTED}→ $fix${RESET}"
        fi
    }

    echo -e "\n  ${BOLD}Core Tools${RESET}"
    command -v java   &>/dev/null && chk "Java"   "true" || chk "Java"   "false" "androstudio install pkg openjdk-21"
    command -v gradle &>/dev/null && chk "Gradle" "true" || chk "Gradle" "false" "androstudio install pkg gradle"
    command -v aapt2  &>/dev/null && chk "aapt2"  "true" || chk "aapt2"  "false" "pkg install aapt2"
    command -v git    &>/dev/null && chk "Git"    "true" || chk "Git"    "false" "pkg install git"
    command -v which  &>/dev/null && chk "which"  "true" || chk "which"  "false" "pkg install which"

    echo -e "\n  ${BOLD}Environment${RESET}"
    local java_home; java_home="$(dirname $(dirname $(readlink -f $(which java))) 2>/dev/null)"
    [ -n "$java_home" ] && chk "JAVA_HOME detected"  "true" || chk "JAVA_HOME detected"  "false" "androstudio install pkg openjdk-21"
    [ -d "$SDK_DIR" ]   && chk "ANDROID_HOME exists" "true" || chk "ANDROID_HOME exists" "false" "androstudio setup"
    local shell_rc; shell_rc=$(detect_shell_rc)
    grep -q "AndroStudio Environment" "$shell_rc" 2>/dev/null \
        && chk "Shell config" "true" || chk "Shell config" "false" "androstudio setup"

    echo -e "\n  ${BOLD}Android SDK${RESET}"
    [ -f "$SDKMANAGER" ]                 && chk "cmdline-tools"  "true" || chk "cmdline-tools"  "false" "androstudio setup"
    [ -f "$SDK_DIR/platform-tools/adb" ] && chk "platform-tools" "true" || chk "platform-tools" "false" "androstudio setup"
    ls "$SDK_DIR/platforms"/android-* &>/dev/null 2>&1 \
        && chk "Android platform" "true" || chk "Android platform" "false" "androstudio setup"
    ls "$SDK_DIR/build-tools"/[0-9]* &>/dev/null 2>&1 \
        && chk "Build-tools"      "true" || chk "Build-tools"      "false" "androstudio setup"
    local lcount=0
    [ -d "$SDK_DIR/licenses" ] && lcount=$(ls "$SDK_DIR/licenses" 2>/dev/null | wc -l)
    [ "$lcount" -gt 0 ] && chk "SDK licenses" "true" || chk "SDK licenses" "false" "androstudio setup"

    echo -e "\n  ${BOLD}Release Packages${RESET}"
    for entry in "${RELEASE_PACKAGES[@]}"; do
        local name
        name=$(echo "$entry" | cut -d'|' -f1)
        dpkg -l "$name" &>/dev/null 2>&1 \
            && chk "$name" "true" \
            || chk "$name" "false" "androstudio install pkg $name"
    done

    echo -e "\n  ${BOLD}NDK + cmake (optional)${RESET}"
    local ndk_ok=false cmake_ok=false
    [ -d "$NDK_DIR" ] && ls "$NDK_DIR"/ &>/dev/null 2>&1 && ndk_ok=true
    [ -d "$CMAKE_DIR" ] && ls "$CMAKE_DIR"/ &>/dev/null 2>&1 && cmake_ok=true
    $ndk_ok   && opt_chk "NDK installed"   "true" || opt_chk "NDK not installed"   "false" "androstudio install ndk"
    $cmake_ok && opt_chk "cmake installed" "true" || opt_chk "cmake not installed" "false" "androstudio install ndk"

    echo ""
    divider
    if [ "$issues" -eq 0 ]; then
        echo -e "  ${GREEN}${BOLD}All checks passed! AndroStudio is ready.${RESET}"
    else
        echo -e "  ${AMBER}${BOLD}$issues issue(s) found.${RESET}"
        echo -e "  ${MUTED}Run 'androstudio doctor' after fixing to verify.${RESET}"
    fi
    echo ""
}

# ═════════════════════════════════════════════════════════════
# ENTRY POINT
# ═════════════════════════════════════════════════════════════
case "${1:-}" in
    setup)   cmd_setup ;;
    install)
        case "${2:-}" in
            ndk) cmd_install_ndk ;;
            pkg) cmd_install_pkg "${3:-}" ;;
            *)
                error "Unknown: androstudio install ${2:-}"
                echo -e "  ${MUTED}Available: androstudio install pkg <name>${RESET}"
                echo -e "  ${MUTED}           androstudio install ndk${RESET}"
                exit 1 ;;
        esac ;;
    status)  cmd_status ;;
    doctor)  cmd_doctor ;;
    version|-v|--version) echo -e "\n  AndroStudio CLI v2.6\n" ;;
    help|-help|--help|"")
        echo ""
        echo -e "  ${BOLD}AndroStudio CLI v2.6${RESET}"
        divider
        echo -e "  ${CYAN}androstudio install pkg <name>${RESET}"
        echo -e "  ${MUTED}    Install a large package from GitHub Releases${RESET}"
        echo -e "  ${MUTED}    Packages: openjdk-21, openjdk-17, gradle${RESET}"
        echo ""
        echo -e "  ${CYAN}androstudio install pkg all${RESET}"
        echo -e "  ${MUTED}    Install all release packages at once${RESET}"
        echo ""
        echo -e "  ${CYAN}androstudio install pkg --list${RESET}"
        echo -e "  ${MUTED}    Show all available release packages${RESET}"
        echo ""
        echo -e "  ${CYAN}androstudio install ndk${RESET}"
        echo -e "  ${MUTED}    Show NDK versions and install selected + cmake${RESET}"
        echo ""
        echo -e "  ${CYAN}androstudio setup${RESET}"
        echo -e "  ${MUTED}    Install openjdk-21, gradle, Android SDK, platform, build-tools${RESET}"
        echo ""
        echo -e "  ${CYAN}androstudio status${RESET}"
        echo -e "  ${MUTED}    Show all installed tools and components${RESET}"
        echo ""
        echo -e "  ${CYAN}androstudio doctor${RESET}"
        echo -e "  ${MUTED}    Check for issues and show fix commands${RESET}"
        echo ""
        echo -e "  ${CYAN}androstudio -help${RESET}"
        echo -e "  ${MUTED}    Show this help${RESET}"
        echo "" ;;
    *)
        error "Unknown command: ${1}"
        echo -e "  ${MUTED}Run: androstudio -help${RESET}"
        exit 1 ;;
esac

