#!/data/data/com.jahangir/files/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════════╗
# ║   AndroStudio CLI Tool v2.8                                  ║
# ║   Usage: androstudio <command> [args]                        ║
# ╚══════════════════════════════════════════════════════════════╝

HOME_DIR="$HOME"
SDK_DIR="$HOME/android-sdk"
NDK_DIR="$SDK_DIR/ndk"
CMAKE_DIR="$SDK_DIR/cmake"
CMDTOOLS_URL="https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip"
CMDTOOLS_DIR="$SDK_DIR/cmdline-tools/latest"
SDKMANAGER="$CMDTOOLS_DIR/bin/sdkmanager"
RELEASE_BASE="https://github.com/devjhr/pkg-repo/releases/download/v1.0"



NDK_VERSIONS=(
    "r29|29.0.14206865|$RELEASE_BASE/android-ndk-r29-aarch64-linux-musl.tar.xz"
)

CMAKE_VERSIONS=("3.10.2" "3.18.1" "3.22.1" "3.25.1")
CMAKE_BASE_URL="https://github.com/MrIkso/AndroidIDE-NDK/releases/download/cmake"

GREEN='\033[0;32m'
AMBER='\033[0;33m'
RED='\033[0;31m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MUTED='\033[0;90m'
BOLD='\033[1m'
RESET='\033[0m'

info()    { echo -e "  ${BLUE}→${RESET} $*"; }
success() { echo -e "  ${GREEN}✓${RESET} $*"; }
warn()    { echo -e "  ${AMBER}!${RESET} $*"; }
error()   { echo -e "  ${RED}✗${RESET} $*"; }
step()    { echo -e "\n  ${BOLD}${CYAN}[$1]${RESET} $2"; }
divider() { echo "  ────────────────────────────────────────────────────"; }

detect_shell_rc() {
    [ -f "$HOME_DIR/.zshrc" ] && echo "$HOME_DIR/.zshrc" || echo "$HOME_DIR/.bashrc"
}

write_env() {
    local shell_rc="$1"
    sed -i '/# ── AndroStudio Environment/,/# ── End AndroStudio/d' "$shell_rc" 2>/dev/null
    cat >> "$shell_rc" << 'ENV'

# ── AndroStudio Environment ────────────────────────────────
export ANDROID_HOME="$HOME/android-sdk"
export ANDROID_SDK_ROOT="$ANDROID_HOME"
export PATH="$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools:$PATH"

export JAVA_HOME="$(dirname $(dirname $(readlink -f $(which java))))"
export PATH="$JAVA_HOME/bin:$PATH"

for ver in $(ls -r $ANDROID_HOME/build-tools/ 2>/dev/null); do
    export PATH="$ANDROID_HOME/build-tools/$ver:$PATH"
done
# ── End AndroStudio ─────────────────────────────────────────
ENV
}

check_java()  { command -v java  &>/dev/null || { error "Java not found — pkg install openjdk-21"; exit 1; }; }

# Checks each tool; if missing, installs it via pkg and continues.
# Only exits if an install actually fails.
# Usage: ensure_tools curl unzip "findutils:find" "gawk:awk" ...
#        (pkg_name:cmd_name — use this form when the package name differs from the command)
ensure_tools() {
    local entry pkg_name cmd_name failed=()
    for entry in "$@"; do
        if [[ "$entry" == *:* ]]; then
            pkg_name="${entry%%:*}"; cmd_name="${entry##*:}"
        else
            pkg_name="$entry"; cmd_name="$entry"
        fi
        if command -v "$cmd_name" &>/dev/null; then
            success "$pkg_name already installed"
        else
            info "Installing $pkg_name..."
            pkg install -y "$pkg_name" &>/dev/null
            if command -v "$cmd_name" &>/dev/null; then
                success "$pkg_name installed!"
            else
                error "$pkg_name install failed"
                failed+=("$pkg_name")
            fi
        fi
    done
    if [ "${#failed[@]}" -gt 0 ]; then
        error "Could not auto-install: ${failed[*]}"
        echo -e "  ${MUTED}→ Try manually: pkg install ${failed[*]}${RESET}"
        exit 1
    fi
}

# ═════════════════════════════════════════════════════════════
# COMMAND: setup
# ═════════════════════════════════════════════════════════════
cmd_setup() {
    echo ""
    echo -e "  ${BOLD}AndroStudio — Full Environment Setup${RESET}"
    divider

    # ── Pre-step 0: required tools ────────────────────────────
    step "1/9" "Checking required tools..."
    ensure_tools curl unzip tar "findutils:find" sed grep "gawk:awk" which

    local shell_rc
    shell_rc=$(detect_shell_rc)

    # ── Pre-step 1: openjdk-21 ────────────────────────────────
    step "2/9" "Installing openjdk-21..."
    dpkg -l openjdk-21 &>/dev/null 2>&1 \
        && success "openjdk-21 already installed" \
        || { pkg install -y openjdk-21 && success "openjdk-21 installed!" || error "openjdk-21 install failed"; }

    check_java

    # ── Pre-step 2: gradle ────────────────────────────────────
    step "3/9" "Installing gradle..."
    dpkg -l gradle &>/dev/null 2>&1 \
        && success "gradle already installed" \
        || { pkg install -y gradle && success "gradle installed!" || error "gradle install failed"; }

    # ── Step 3: SDK directory ─────────────────────────────────
    step "4/9" "Creating SDK directory structure..."
    mkdir -p "$SDK_DIR"/{cmdline-tools,platform-tools,platforms,build-tools,ndk,cmake,licenses}
    success "SDK root: $SDK_DIR"

    # ── Step 4: cmdline-tools ─────────────────────────────────
    step "5/9" "Downloading Android cmdline-tools..."
    if [ -f "$SDKMANAGER" ]; then
        success "cmdline-tools already installed"
    else
        local tmp_zip="$TMPDIR/cmdtools.zip" tmp_dir="$TMPDIR/cmdtools-extract"
        curl -L --progress-bar "$CMDTOOLS_URL" -o "$tmp_zip"
        [ ! -f "$tmp_zip" ] && error "Download failed!" && exit 1
        rm -rf "$tmp_dir"
        unzip -q "$tmp_zip" -d "$tmp_dir"
        mkdir -p "$CMDTOOLS_DIR"
        if [ -d "$tmp_dir/cmdline-tools" ]; then
            cp -r "$tmp_dir/cmdline-tools/." "$CMDTOOLS_DIR/"
        else
            cp -r "$tmp_dir/." "$CMDTOOLS_DIR/"
        fi
        rm -rf "$tmp_zip" "$tmp_dir"
        success "cmdline-tools installed"
    fi
    chmod -R 755 "$CMDTOOLS_DIR/bin/" 2>/dev/null

    # ── Step 5: Accept licenses ───────────────────────────────
    step "6/9" "Accepting Android SDK licenses..."
    export ANDROID_HOME="$SDK_DIR"
    export ANDROID_SDK_ROOT="$SDK_DIR"
    export JAVA_HOME="$(dirname $(dirname $(readlink -f $(which java))))"
    export PATH="$JAVA_HOME/bin:$CMDTOOLS_DIR/bin:$SDK_DIR/platform-tools:$PATH"
    yes | "$SDKMANAGER" --licenses > /dev/null 2>&1 \
        && success "All licenses accepted" \
        || warn "Some licenses may not have been accepted"

    # ── Step 6: platform-tools ────────────────────────────────
    step "7/9" "Installing platform-tools..."
    "$SDKMANAGER" "platform-tools" && success "platform-tools installed" || warn "Failed"

    # ── Step 7: platform + build-tools ───────────────────────
    # Default: android-36 + build-tools 36.0.0 (most widely used stable)
    # To target a different version: androstudio install sdk platform <API> buildtools <ver>
    step "8/9" "Installing Android platform and build-tools..."
    local target_platform="platforms;android-36"
    local target_buildtools="build-tools;36.0.0"
    info "Platform   : $target_platform"
    info "Build-tools: $target_buildtools"
    "$SDKMANAGER" "$target_platform" "$target_buildtools" \
        && success "Platform + build-tools installed" || warn "Partially failed"

    # ── Step 8: Write env ─────────────────────────────────────
    step "9/9" "Writing environment variables..."
    write_env "$shell_rc"
    success "Written to $shell_rc"

    echo ""
    divider
    echo -e "  ${GREEN}${BOLD}Setup complete!${RESET}"
    divider
    printf "  %-20s %s\n" "ANDROID_HOME:" "$SDK_DIR"
    printf "  %-20s %s\n" "JAVA_HOME:"    "$(dirname $(dirname $(readlink -f $(which java))))"
    printf "  %-20s %s\n" "Platform:"     "$target_platform"
    printf "  %-20s %s\n" "Build-tools:"  "$target_buildtools"
    echo ""
    echo -e "  Apply now: ${CYAN}source $shell_rc${RESET}"
    echo ""
}

# ═════════════════════════════════════════════════════════════
# COMMAND: install ndk
# ═════════════════════════════════════════════════════════════
cmd_install_ndk() {
    echo ""
    echo -e "  ${BOLD}AndroStudio — Install NDK + cmake${RESET}"
    divider
    echo -e "  ${MUTED}Source: github.com/devjhr/pkg-repo/releases${RESET}"
    echo ""

    ensure_tools curl unzip tar "findutils:find" sed

    echo -e "  ${BOLD}Available NDK versions:${RESET}"
    echo ""
    local i=1
    for entry in "${NDK_VERSIONS[@]}"; do
        local name ver
        name=$(echo "$entry" | cut -d'|' -f1)
        ver=$(echo "$entry"  | cut -d'|' -f2)
        local installed=""
        [ -d "$NDK_DIR/$ver" ] && installed="${GREEN} ✓ installed${RESET}"
        echo -e "  ${CYAN}[$i]${RESET} NDK $name  ${MUTED}($ver)${RESET}$installed"
        i=$((i + 1))
    done
    echo -e "  ${CYAN}[q]${RESET} Cancel"
    echo ""
    printf "  Select [1-${#NDK_VERSIONS[@]}]: "
    read -r choice

    [ "$choice" = "q" ] && echo "" && info "Cancelled." && echo "" && return

    if ! [[ "$choice" =~ ^[0-9]+$ ]] || [ "$choice" -lt 1 ] || [ "$choice" -gt "${#NDK_VERSIONS[@]}" ]; then
        error "Invalid selection"; exit 1
    fi

    local selected="${NDK_VERSIONS[$((choice - 1))]}"
    local ndk_name ndk_ver ndk_url
    ndk_name=$(echo "$selected" | cut -d'|' -f1)
    ndk_ver=$(echo "$selected"  | cut -d'|' -f2)
    ndk_url=$(echo "$selected"  | cut -d'|' -f3)

    local ndk_install_dir="$NDK_DIR/$ndk_ver"
    local ndk_file
    ndk_file=$(basename "$ndk_url")

    echo ""
    info "Selected: NDK $ndk_name ($ndk_ver)"

    _do_install_ndk_files() {
        local home_ndk=""
        [ -d "$HOME_DIR/$ndk_ver" ]              && home_ndk="$HOME_DIR/$ndk_ver"
        [ -d "$HOME_DIR/android-ndk-$ndk_name" ] && home_ndk="$HOME_DIR/android-ndk-$ndk_name"

        if [ -n "$home_ndk" ]; then
            info "Found NDK at $home_ndk — moving to SDK..."
            mkdir -p "$NDK_DIR"
            mv "$home_ndk" "$ndk_install_dir"
            success "Moved to $ndk_install_dir"
        else
            info "Downloading NDK $ndk_name..."
            info "URL: $ndk_url"
            curl -L --progress-bar "$ndk_url" -o "$TMPDIR/$ndk_file"
            if [ ! -s "$TMPDIR/$ndk_file" ]; then
                error "Download failed!"; rm -f "$TMPDIR/$ndk_file"; exit 1
            fi
            info "Extracting NDK $ndk_name..."
            cd "$HOME_DIR"
            tar --no-same-owner -xf "$TMPDIR/$ndk_file" --warning=no-unknown-keyword
            rm -f "$TMPDIR/$ndk_file"
            mkdir -p "$NDK_DIR"
            local extracted_dir
            extracted_dir=$(find "$HOME_DIR" -maxdepth 1 -type d \( -name "android-ndk-*" -o -name "$ndk_ver" \) | head -1)
            if [ -n "$extracted_dir" ]; then
                mv "$extracted_dir" "$ndk_install_dir"
            else
                error "Could not find extracted NDK folder in $HOME_DIR"
                exit 1
            fi
        fi
    }

    if [ -d "$ndk_install_dir" ]; then
        warn "NDK $ndk_name is already installed at $ndk_install_dir"
        printf "  Force reinstall? [y/N]: "
        read -r force_ndk
        if [ "$force_ndk" != "y" ] && [ "$force_ndk" != "Y" ]; then
            info "Skipped NDK $ndk_name"
        else
            info "Removing NDK $ndk_name for reinstall..."
            rm -rf "$ndk_install_dir"
            _do_install_ndk_files
        fi
    else
        _do_install_ndk_files
    fi

    if [ -d "$ndk_install_dir" ]; then
        info "Creating missing symlinks for musl..."
        for path in "toolchains/llvm/prebuilt" "prebuilt" "shader-tools"; do
            if [ -d "$ndk_install_dir/$path" ]; then
                cd "$ndk_install_dir/$path"
                [ ! -e "linux-aarch64" ] && ln -s linux-arm64 linux-aarch64 2>/dev/null
            fi
        done
        success "NDK $ndk_name ready at $ndk_install_dir"
    fi

    echo ""
    printf "  Install cmake now? [y/n]: "
    read -r cmake_choice
    if [ "$cmake_choice" = "y" ] || [ "$cmake_choice" = "Y" ]; then
        _do_install_cmake
    else
        info "Skipped cmake. Run later: androstudio install cmake"
    fi

    local shell_rc; shell_rc=$(detect_shell_rc)
    write_env "$shell_rc"

    echo ""
    divider
    success "NDK installation complete!"
    echo -e "  Apply now: ${CYAN}source $shell_rc${RESET}"
    echo ""
}

# ═════════════════════════════════════════════════════════════
# COMMAND: install sdk
# ─────────────────────────────────────────────────────────────
# দুটো মোডে কাজ করে:
#
# ১. Parameter মোড (SDK Manager স্ক্রিন থেকে সরাসরি call করার জন্য):
#      androstudio install sdk platform <API>
#      androstudio install sdk buildtools <version>
#      androstudio install sdk platform <API> buildtools <version>
#    উদাহরণ:
#      androstudio install sdk platform 35
#      androstudio install sdk buildtools 34.0.0
#      androstudio install sdk platform 36 buildtools 36.0.0
#
# ২. Interactive মোড (parameter না দিলে):
#      androstudio install sdk
# ═════════════════════════════════════════════════════════════
cmd_install_sdk() {
    echo ""
    echo -e "  ${BOLD}AndroStudio — Install Android SDK Components${RESET}"
    divider

    if [ ! -f "$SDKMANAGER" ]; then
        error "cmdline-tools not found. Run: androstudio setup"
        exit 1
    fi

    export ANDROID_HOME="$SDK_DIR"
    export ANDROID_SDK_ROOT="$SDK_DIR"
    export JAVA_HOME="$(dirname $(dirname $(readlink -f $(which java))))"
    export PATH="$JAVA_HOME/bin:$CMDTOOLS_DIR/bin:$SDK_DIR/platform-tools:$PATH"

    # ── Parse parameters ($3, $4, $5, $6 — after "install sdk") ──
    # Supported: platform <API> | buildtools <ver> | platform <API> buildtools <ver>
    local param_api="" param_bt=""
    local args=("${@}")   # remaining args passed from entry point
    local i=0
    while [ $i -lt ${#args[@]} ]; do
        case "${args[$i]}" in
            platform)
                i=$((i+1)); param_api="${args[$i]}" ;;
            buildtools)
                i=$((i+1)); param_bt="${args[$i]}" ;;
        esac
        i=$((i+1))
    done

    # ── Parameter mode: non-interactive ──────────────────────
    if [ -n "$param_api" ] || [ -n "$param_bt" ]; then
        if [ -n "$param_api" ]; then
            local pkg_platform="platforms;android-${param_api}"
            info "Installing $pkg_platform..."
            "$SDKMANAGER" "$pkg_platform" \
                && success "$pkg_platform installed" \
                || { error "Failed: $pkg_platform"; exit 1; }
        fi
        if [ -n "$param_bt" ]; then
            local pkg_bt="build-tools;${param_bt}"
            info "Installing $pkg_bt..."
            "$SDKMANAGER" "$pkg_bt" \
                && success "$pkg_bt installed" \
                || { error "Failed: $pkg_bt"; exit 1; }
        fi
        echo ""
        divider
        success "SDK install complete!"
        echo ""
        return
    fi

    # ── Interactive mode ──────────────────────────────────────
    echo -e "\n  ${BOLD}Currently installed:${RESET}"
    if ls "$SDK_DIR/platforms"/android-* &>/dev/null 2>&1; then
        for p in "$SDK_DIR/platforms"/android-*/; do
            echo -e "  ${GREEN}✓${RESET} platform        $(basename "$p")"
        done
    else
        echo -e "  ${AMBER}–${RESET} No platforms installed"
    fi
    if ls "$SDK_DIR/build-tools"/[0-9]* &>/dev/null 2>&1; then
        for b in "$SDK_DIR/build-tools"/*/; do
            echo -e "  ${GREEN}✓${RESET} build-tools     $(basename "$b")"
        done
    else
        echo -e "  ${AMBER}–${RESET} No build-tools installed"
    fi

    echo ""
    echo -e "  ${BOLD}What do you want to install?${RESET}"
    echo ""
    echo -e "  ${CYAN}[1]${RESET} Android platform only"
    echo -e "  ${CYAN}[2]${RESET} Build-tools only"
    echo -e "  ${CYAN}[3]${RESET} Both platform + build-tools"
    echo -e "  ${CYAN}[q]${RESET} Cancel"
    echo ""
    printf "  Select [1-3/q]: "
    read -r sdk_choice

    [ "$sdk_choice" = "q" ] && info "Cancelled." && echo "" && return

    local do_platform=false do_buildtools=false
    case "$sdk_choice" in
        1) do_platform=true ;;
        2) do_buildtools=true ;;
        3) do_platform=true; do_buildtools=true ;;
        *) error "Invalid selection"; exit 1 ;;
    esac

    if $do_platform; then
        echo ""
        echo -e "  ${BOLD}Platform API levels:${RESET}"
        echo ""
        local PLATFORM_LIST=("36" "35" "34" "33" "32" "31" "30")
        local i=1
        for api in "${PLATFORM_LIST[@]}"; do
            local installed=""
            [ -d "$SDK_DIR/platforms/android-$api" ] && installed="${GREEN} ✓${RESET}"
            echo -e "  ${CYAN}[$i]${RESET} platforms;android-${api}${installed}"
            i=$((i+1))
        done
        echo -e "  ${CYAN}[c]${RESET} Custom API level"
        echo ""
        printf "  Select [1-${#PLATFORM_LIST[@]}/c]: "
        read -r p_choice

        local sel_api=""
        if [ "$p_choice" = "c" ]; then
            printf "  API level: "; read -r sel_api
        elif [[ "$p_choice" =~ ^[0-9]+$ ]] && [ "$p_choice" -ge 1 ] && [ "$p_choice" -le "${#PLATFORM_LIST[@]}" ]; then
            sel_api="${PLATFORM_LIST[$((p_choice-1))]}"
        else
            error "Invalid selection"; exit 1
        fi
        if [ -d "$SDK_DIR/platforms/android-${sel_api}" ]; then
            warn "platforms;android-${sel_api} is already installed"
            printf "  Force reinstall? [y/N]: "
            read -r force_plat
            if [ "$force_plat" != "y" ] && [ "$force_plat" != "Y" ]; then
                info "Skipped platforms;android-${sel_api}"
            else
                info "Reinstalling platforms;android-${sel_api}..."
                "$SDKMANAGER" --uninstall "platforms;android-${sel_api}" &>/dev/null
                "$SDKMANAGER" "platforms;android-${sel_api}" \
                    && success "platforms;android-${sel_api} reinstalled" || error "Failed"
            fi
        else
            info "Installing platforms;android-${sel_api}..."
            "$SDKMANAGER" "platforms;android-${sel_api}" \
                && success "platforms;android-${sel_api} installed" || error "Failed"
        fi
    fi

    if $do_buildtools; then
        echo ""
        echo -e "  ${BOLD}Build-tools versions:${RESET}"
        echo ""
        local BT_LIST=("36.0.0" "35.0.0" "34.0.0" "33.0.2" "32.0.0" "31.0.0" "30.0.3")
        local i=1
        for bt in "${BT_LIST[@]}"; do
            local installed=""
            [ -d "$SDK_DIR/build-tools/$bt" ] && installed="${GREEN} ✓${RESET}"
            echo -e "  ${CYAN}[$i]${RESET} build-tools;${bt}${installed}"
            i=$((i+1))
        done
        echo -e "  ${CYAN}[c]${RESET} Custom version"
        echo ""
        printf "  Select [1-${#BT_LIST[@]}/c]: "
        read -r bt_choice

        local sel_bt=""
        if [ "$bt_choice" = "c" ]; then
            printf "  Version: "; read -r sel_bt
        elif [[ "$bt_choice" =~ ^[0-9]+$ ]] && [ "$bt_choice" -ge 1 ] && [ "$bt_choice" -le "${#BT_LIST[@]}" ]; then
            sel_bt="${BT_LIST[$((bt_choice-1))]}"
        else
            error "Invalid selection"; exit 1
        fi
        if [ -d "$SDK_DIR/build-tools/${sel_bt}" ]; then
            warn "build-tools;${sel_bt} is already installed"
            printf "  Force reinstall? [y/N]: "
            read -r force_bt
            if [ "$force_bt" != "y" ] && [ "$force_bt" != "Y" ]; then
                info "Skipped build-tools;${sel_bt}"
            else
                info "Reinstalling build-tools;${sel_bt}..."
                "$SDKMANAGER" --uninstall "build-tools;${sel_bt}" &>/dev/null
                "$SDKMANAGER" "build-tools;${sel_bt}" \
                    && success "build-tools;${sel_bt} reinstalled" || error "Failed"
            fi
        else
            info "Installing build-tools;${sel_bt}..."
            "$SDKMANAGER" "build-tools;${sel_bt}" \
                && success "build-tools;${sel_bt} installed" || error "Failed"
        fi
    fi

    echo ""
    divider
    success "SDK install complete!"
    echo -e "  ${MUTED}Tip: androstudio status — verify installed components${RESET}"
    echo ""
}

# ═════════════════════════════════════════════════════════════
# COMMAND: install cmake
# ═════════════════════════════════════════════════════════════
_do_install_cmake() {
    echo ""
    echo -e "  ${BOLD}Available cmake versions:${RESET}"
    echo -e "  ${MUTED}Source: github.com/MrIkso/AndroidIDE-NDK${RESET}"
    echo ""

    local i=1
    for cmake_ver in "${CMAKE_VERSIONS[@]}"; do
        local installed=""
        [ -d "$CMAKE_DIR/$cmake_ver" ] && installed="${GREEN} ✓ installed${RESET}"
        echo -e "  ${CYAN}[$i]${RESET} cmake $cmake_ver$installed"
        i=$((i + 1))
    done
    echo -e "  ${CYAN}[a]${RESET} Install all"
    echo -e "  ${CYAN}[q]${RESET} Cancel"
    echo ""
    printf "  Select [1-${#CMAKE_VERSIONS[@]}/a/q]: "
    read -r cmake_sel

    [ "$cmake_sel" = "q" ] && info "Cancelled." && return

    ensure_tools curl unzip sed
    mkdir -p "$CMAKE_DIR"

    if [ "$cmake_sel" = "a" ]; then
        for cmake_ver in "${CMAKE_VERSIONS[@]}"; do
            _download_cmake "$cmake_ver"
        done
    elif [[ "$cmake_sel" =~ ^[0-9]+$ ]] && [ "$cmake_sel" -ge 1 ] && [ "$cmake_sel" -le "${#CMAKE_VERSIONS[@]}" ]; then
        local selected_ver="${CMAKE_VERSIONS[$((cmake_sel - 1))]}"
        _download_cmake "$selected_ver"
    else
        error "Invalid selection"
    fi
}

_download_cmake() {
    local cmake_ver="$1"
    if [ -d "$CMAKE_DIR/$cmake_ver" ]; then
        warn "cmake $cmake_ver is already installed"
        printf "  Force reinstall? [y/N]: "
        read -r force_choice
        if [ "$force_choice" != "y" ] && [ "$force_choice" != "Y" ]; then
            info "Skipped cmake $cmake_ver"
            return
        fi
        info "Removing cmake $cmake_ver for reinstall..."
        rm -rf "$CMAKE_DIR/$cmake_ver"
    fi
    local cmake_file="cmake-${cmake_ver}-android-aarch64.zip"
    info "Downloading cmake $cmake_ver..."
    curl -L --progress-bar "$CMAKE_BASE_URL/$cmake_file" -o "$TMPDIR/$cmake_file"
    if [ ! -s "$TMPDIR/$cmake_file" ]; then
        warn "cmake $cmake_ver download failed — skipping"; return
    fi
    unzip -qq "$TMPDIR/$cmake_file" -d "$CMAKE_DIR"
    rm -f "$TMPDIR/$cmake_file"
    chmod -R +x "$CMAKE_DIR/$cmake_ver/bin" 2>/dev/null
    success "cmake $cmake_ver installed"
}

cmd_install_cmake() {
    echo ""
    echo -e "  ${BOLD}AndroStudio — Install cmake${RESET}"
    divider
    _do_install_cmake
    local shell_rc; shell_rc=$(detect_shell_rc)
    write_env "$shell_rc"
    echo ""
    divider
    success "cmake installation complete!"
    echo -e "  Apply now: ${CYAN}source $shell_rc${RESET}"
    echo ""
}

# ═════════════════════════════════════════════════════════════
# COMMAND: status
# ═════════════════════════════════════════════════════════════
cmd_status() {
    echo ""
    echo -e "  ${BOLD}AndroStudio — Status${RESET}"
    divider

    show_tool() {
        local name="$1" cmd="$2" fix="$3"
        if command -v "$cmd" &>/dev/null; then
            local ver; ver=$("$cmd" --version 2>/dev/null | head -1 || echo "")
            echo -e "  ${GREEN}✓${RESET} $(printf '%-16s' "$name") ${MUTED}$ver${RESET}"
        else
            echo -e "  ${RED}✗${RESET} $(printf '%-16s' "$name") ${MUTED}not installed — $fix${RESET}"
        fi
    }

    echo -e "\n  ${BOLD}Core Tools${RESET}"
    show_tool "java"   "java"   "pkg install openjdk-21"
    show_tool "gradle" "gradle" "pkg install gradle"
    show_tool "aapt2"  "aapt2"  "pkg install aapt2"
    show_tool "git"    "git"    "pkg install git"

    echo -e "\n  ${BOLD}Environment${RESET}"
    local java_home; java_home="$(dirname $(dirname $(readlink -f $(which java))) 2>/dev/null)"
    [ -n "$java_home" ] \
        && echo -e "  ${GREEN}✓${RESET} JAVA_HOME       $java_home" \
        || echo -e "  ${RED}✗${RESET} JAVA_HOME       not detected"
    [ -d "$SDK_DIR" ] \
        && echo -e "  ${GREEN}✓${RESET} ANDROID_HOME    $SDK_DIR" \
        || echo -e "  ${RED}✗${RESET} ANDROID_HOME    not found — androstudio setup"

    echo -e "\n  ${BOLD}Android SDK${RESET}"
    [ -f "$SDKMANAGER" ] \
        && echo -e "  ${GREEN}✓${RESET} cmdline-tools" \
        || echo -e "  ${RED}✗${RESET} cmdline-tools   not installed — androstudio setup"
    [ -f "$SDK_DIR/platform-tools/adb" ] \
        && echo -e "  ${GREEN}✓${RESET} platform-tools" \
        || echo -e "  ${RED}✗${RESET} platform-tools  not installed — androstudio setup"
    if ls "$SDK_DIR/platforms"/android-* &>/dev/null 2>&1; then
        for p in "$SDK_DIR/platforms"/android-*/; do
            echo -e "  ${GREEN}✓${RESET} platform        $(basename "$p")"
        done
    else
        echo -e "  ${RED}✗${RESET} platform        none — androstudio setup"
    fi
    if ls "$SDK_DIR/build-tools"/[0-9]* &>/dev/null 2>&1; then
        for b in "$SDK_DIR/build-tools"/*/; do
            echo -e "  ${GREEN}✓${RESET} build-tools     $(basename "$b")"
        done
    else
        echo -e "  ${RED}✗${RESET} build-tools     none — androstudio setup"
    fi
    local lcount=0
    [ -d "$SDK_DIR/licenses" ] && lcount=$(ls "$SDK_DIR/licenses" 2>/dev/null | wc -l)
    [ "$lcount" -gt 0 ] \
        && echo -e "  ${GREEN}✓${RESET} licenses        $lcount accepted" \
        || echo -e "  ${RED}✗${RESET} licenses        not accepted — androstudio setup"

    echo -e "\n  ${BOLD}Packages${RESET}"
    for name in openjdk-21 gradle; do
        if dpkg -l "$name" &>/dev/null 2>&1; then
            local ver; ver=$(dpkg -l "$name" 2>/dev/null | awk '/^ii/{print $3}')
            echo -e "  ${GREEN}✓${RESET} $(printf '%-16s' "$name") ${MUTED}$ver${RESET}"
        else
            echo -e "  ${RED}✗${RESET} $(printf '%-16s' "$name") ${MUTED}not installed — pkg install $name${RESET}"
        fi
    done

    echo -e "\n  ${BOLD}NDK${RESET}"
    local ndk_found=0
    if [ -d "$NDK_DIR" ]; then
        for d in "$NDK_DIR"/*/; do
            [ -d "$d" ] && echo -e "  ${GREEN}✓${RESET} NDK             $(basename "$d")" && ndk_found=1
        done
    fi
    [ "$ndk_found" -eq 0 ] && echo -e "  ${AMBER}–${RESET} NDK             not installed — androstudio install ndk"

    echo -e "\n  ${BOLD}cmake${RESET}"
    local cmake_found=0
    if [ -d "$CMAKE_DIR" ]; then
        for d in "$CMAKE_DIR"/*/; do
            [ -d "$d" ] && echo -e "  ${GREEN}✓${RESET} cmake           $(basename "$d")" && cmake_found=1
        done
    fi
    [ "$cmake_found" -eq 0 ] && echo -e "  ${AMBER}–${RESET} cmake           not installed — androstudio install ndk"
    echo ""
}

# ═════════════════════════════════════════════════════════════
# COMMAND: doctor
# ═════════════════════════════════════════════════════════════
cmd_doctor() {
    echo ""
    echo -e "  ${BOLD}AndroStudio — Doctor${RESET}"
    divider

    local issues=0

    chk() {
        local label="$1" ok="$2" fix="$3"
        if [ "$ok" = "true" ]; then
            echo -e "  ${GREEN}✓${RESET} $label"
        else
            echo -e "  ${RED}✗${RESET} $label"
            [ -n "$fix" ] && echo -e "    ${MUTED}→ Fix: $fix${RESET}"
            issues=$((issues + 1))
        fi
    }
    opt_chk() {
        local label="$1" ok="$2" fix="$3"
        if [ "$ok" = "true" ]; then
            echo -e "  ${GREEN}✓${RESET} $label"
        else
            echo -e "  ${AMBER}–${RESET} $label ${MUTED}(optional)${RESET}"
            [ -n "$fix" ] && echo -e "    ${MUTED}→ $fix${RESET}"
        fi
    }

    echo -e "\n  ${BOLD}Core Tools${RESET}"
    command -v java   &>/dev/null && chk "Java"   "true" || chk "Java"   "false" "pkg install openjdk-21"
    command -v gradle &>/dev/null && chk "Gradle" "true" || chk "Gradle" "false" "pkg install gradle"
    command -v aapt2  &>/dev/null && chk "aapt2"  "true" || chk "aapt2"  "false" "pkg install aapt2"
    command -v git    &>/dev/null && chk "Git"    "true" || chk "Git"    "false" "pkg install git"
    command -v which  &>/dev/null && chk "which"  "true" || chk "which"  "false" "pkg install which"

    echo -e "\n  ${BOLD}Environment${RESET}"
    local java_home; java_home="$(dirname $(dirname $(readlink -f $(which java))) 2>/dev/null)"
    [ -n "$java_home" ] && chk "JAVA_HOME detected"  "true" || chk "JAVA_HOME detected"  "false" "pkg install openjdk-21"
    [ -d "$SDK_DIR" ]   && chk "ANDROID_HOME exists" "true" || chk "ANDROID_HOME exists" "false" "androstudio setup"
    local shell_rc; shell_rc=$(detect_shell_rc)
    grep -q "AndroStudio Environment" "$shell_rc" 2>/dev/null \
        && chk "Shell config" "true" || chk "Shell config" "false" "androstudio setup"

    echo -e "\n  ${BOLD}Android SDK${RESET}"
    [ -f "$SDKMANAGER" ]                 && chk "cmdline-tools"  "true" || chk "cmdline-tools"  "false" "androstudio setup"
    [ -f "$SDK_DIR/platform-tools/adb" ] && chk "platform-tools" "true" || chk "platform-tools" "false" "androstudio setup"
    ls "$SDK_DIR/platforms"/android-* &>/dev/null 2>&1 \
        && chk "Android platform" "true" || chk "Android platform" "false" "androstudio setup"
    ls "$SDK_DIR/build-tools"/[0-9]* &>/dev/null 2>&1 \
        && chk "Build-tools"      "true" || chk "Build-tools"      "false" "androstudio setup"
    local lcount=0
    [ -d "$SDK_DIR/licenses" ] && lcount=$(ls "$SDK_DIR/licenses" 2>/dev/null | wc -l)
    [ "$lcount" -gt 0 ] && chk "SDK licenses" "true" || chk "SDK licenses" "false" "androstudio setup"

    echo -e "\n  ${BOLD}Packages${RESET}"
    for name in openjdk-21 gradle; do
        dpkg -l "$name" &>/dev/null 2>&1 \
            && chk "$name" "true" \
            || chk "$name" "false" "pkg install $name"
    done

    echo -e "\n  ${BOLD}NDK + cmake (optional)${RESET}"
    local ndk_ok=false cmake_ok=false
    [ -d "$NDK_DIR" ] && ls "$NDK_DIR"/ &>/dev/null 2>&1 && ndk_ok=true
    [ -d "$CMAKE_DIR" ] && ls "$CMAKE_DIR"/ &>/dev/null 2>&1 && cmake_ok=true
    $ndk_ok   && opt_chk "NDK installed"   "true" || opt_chk "NDK not installed"   "false" "androstudio install ndk"
    $cmake_ok && opt_chk "cmake installed" "true" || opt_chk "cmake not installed" "false" "androstudio install ndk"

    echo ""
    divider
    if [ "$issues" -eq 0 ]; then
        echo -e "  ${GREEN}${BOLD}All checks passed! AndroStudio is ready.${RESET}"
    else
        echo -e "  ${AMBER}${BOLD}$issues issue(s) found.${RESET}"
        echo -e "  ${MUTED}Run 'androstudio doctor' after fixing to verify.${RESET}"
    fi
    echo ""
}

# ═════════════════════════════════════════════════════════════
# ENTRY POINT
# ═════════════════════════════════════════════════════════════
case "${1:-}" in
    setup)   cmd_setup ;;
    install)
        case "${2:-}" in
            ndk)   cmd_install_ndk ;;
            cmake) cmd_install_cmake ;;
            sdk)   cmd_install_sdk "${@:3}" ;;
            *)
                error "Unknown: androstudio install ${2:-}"
                echo -e "  ${MUTED}Available: androstudio install ndk${RESET}"
                echo -e "  ${MUTED}           androstudio install cmake${RESET}"
                echo -e "  ${MUTED}           androstudio install sdk [platform <API>] [buildtools <ver>]${RESET}"
                exit 1 ;;
        esac ;;
    status)  cmd_status ;;
    doctor)  cmd_doctor ;;
    version|-v|--version) echo -e "\n  AndroStudio CLI v2.8\n" ;;
    help|-help|--help|"")
        echo ""
        echo -e "  ${BOLD}AndroStudio CLI v2.8${RESET}"
        divider
        echo -e "  ${CYAN}androstudio install ndk${RESET}"
        echo -e "  ${MUTED}    Show NDK versions and install selected + cmake (optional)${RESET}"
        echo ""
        echo -e "  ${CYAN}androstudio install cmake${RESET}"
        echo -e "  ${MUTED}    Select and install cmake version(s) independently${RESET}"
        echo ""
        echo -e "  ${CYAN}androstudio install sdk [platform <API>] [buildtools <ver>]${RESET}"
        echo -e "  ${MUTED}    Install Android platform or build-tools (interactive or direct)${RESET}"
        echo -e "  ${MUTED}    e.g. androstudio install sdk platform 35${RESET}"
        echo -e "  ${MUTED}    e.g. androstudio install sdk platform 36 buildtools 36.0.0${RESET}"
        echo ""
        echo -e "  ${CYAN}androstudio setup${RESET}"
        echo -e "  ${MUTED}    Install openjdk-21, gradle, Android SDK (android-36 + build-tools 36.0.0)${RESET}"
        echo ""
        echo -e "  ${CYAN}androstudio status${RESET}"
        echo -e "  ${MUTED}    Show all installed tools and components${RESET}"
        echo ""
        echo -e "  ${CYAN}androstudio doctor${RESET}"
        echo -e "  ${MUTED}    Check for issues and show fix commands${RESET}"
        echo ""
        echo -e "  ${CYAN}androstudio -help${RESET}"
        echo -e "  ${MUTED}    Show this help${RESET}"
        echo "" ;;
    *)
        error "Unknown command: ${1}"
        echo -e "  ${MUTED}Run: androstudio -help${RESET}"
        exit 1 ;;
esac


